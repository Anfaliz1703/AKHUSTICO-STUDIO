# AKHUSTICO Studio environment

# PostgreSQL / Neon.
# Empty = DEMO MODE with local file persistence at .akhustico-data/.
# Present = real PostgreSQL. Connection failures are not silently downgraded.
DATABASE_URL=
AKHUSTICO_DATA_DIR=

# Auth.js / Google OAuth.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OWNER_EMAIL=

# Vercel Blob. Empty = simulated demo upload URL.
BLOB_READ_WRITE_TOKEN=

# External Python audio worker. Empty or AUDIO_WORKER_ENABLED!=true = mock provider.
AUDIO_WORKER_URL=
AUDIO_WORKER_ENABLED=false
WORKER_SECRET=

# Local development only. Blocked in Vercel production by auth guard.
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
